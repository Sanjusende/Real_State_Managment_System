PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://localhost:27017/real_estate_db
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRES_IN=7d

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Contact / Email
ADMIN_EMAIL=admin@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_username@gmail.com
SMTP_PASSWORD=your_smtp_app_password
SMTP_FROM_NAME=EstateCraft Support
SMTP_FROM_EMAIL=noreply@example.com

# WhatsApp Notifications (Method 1: CallMeBot Free Gateway | Method 2: Meta Cloud API)
CALLMEBOT_API_KEY=your_free_callmebot_api_key
WHATSAPP_ADMIN_NUMBER=+919876543210

# Meta WhatsApp Cloud API (Optional alternative)
WHATSAPP_ACCESS_TOKEN=your_whatsapp_permanent_or_system_user_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_API_VERSION=v21.0

# Optional Features
CONTACT_AUTO_REPLY_ENABLED=false

